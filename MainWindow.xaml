<Window x:Class="AutoServiceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoService Manager" Height="760" Width="1180"
        MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172033">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,16,22">
                    <TextBlock Text="AUTO SERVICE" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="MANAGER" Foreground="#8FA7D7" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Button Content="Главная" Tag="Home" Click="Navigation_Click" Background="#263653" HorizontalContentAlignment="Left"/>
                    <Button Content="Клиенты" Tag="Clients" Click="Navigation_Click" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Автомобили" Tag="Vehicles" Click="Navigation_Click" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="Заказы на ремонт" Tag="Orders" Click="Navigation_Click" Background="Transparent" HorizontalContentAlignment="Left"/>
                    <Button Content="О программе" Tag="About" Click="Navigation_Click" Background="Transparent" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="AutoService Manager • .NET 10"
                           Foreground="#8793A8" FontSize="10" Margin="18,12,12,18"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="27" FontWeight="Bold" Foreground="#172033"/>
                <TextBlock x:Name="PageSubtitle" Text="Краткая информация о работе автосервиса"
                           FontSize="13" Foreground="#6B7485" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="HomePage">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="White" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Клиенты" Foreground="#6B7485"/>
                                    <TextBlock x:Name="ClientsCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Автомобили" Foreground="#6B7485"/>
                                    <TextBlock x:Name="VehiclesCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="10" Padding="18" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Заказы" Foreground="#6B7485"/>
                                    <TextBlock x:Name="OrdersCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="White" CornerRadius="10" Padding="22" Margin="4">
                            <StackPanel>
                                <TextBlock Text="Добро пожаловать в AutoService Manager" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>
                                <TextBlock Text="Приложение предназначено для учёта клиентов, автомобилей и заказов на обслуживание."
                                           TextWrapping="Wrap" Foreground="#6B7485" Margin="0,10,0,0"/>
                                <TextBlock Text="Начните работу с добавления клиента, затем зарегистрируйте его автомобиль и создайте заказ на ремонт."
                                           TextWrapping="Wrap" Foreground="#6B7485" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ClientsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="14">
                        <WrapPanel>
                            <TextBox x:Name="ClientNameBox" Width="210" ToolTip="ФИО клиента"/>
                            <TextBox x:Name="ClientPhoneBox" Width="155" ToolTip="Телефон"/>
                            <TextBox x:Name="ClientEmailBox" Width="190" ToolTip="Электронная почта"/>
                            <Button Content="Добавить клиента" Click="AddClient_Click"/>
                            <Button Content="Удалить выбранного" Click="DeleteClient_Click" Background="#B42318"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="ClientsGrid" Grid.Row="1" ItemsSource="{Binding Clients}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="VehiclesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="14">
                        <WrapPanel>
                            <ComboBox x:Name="VehicleClientBox" Width="180" DisplayMemberPath="FullName" SelectedValuePath="Id" ToolTip="Владелец"/>
                            <TextBox x:Name="VehicleBrandBox" Width="115" ToolTip="Марка"/>
                            <TextBox x:Name="VehicleModelBox" Width="115" ToolTip="Модель"/>
                            <TextBox x:Name="VehicleNumberBox" Width="125" ToolTip="Госномер"/>
                            <TextBox x:Name="VehicleYearBox" Width="80" ToolTip="Год"/>
                            <Button Content="Добавить автомобиль" Click="AddVehicle_Click"/>
                            <Button Content="Удалить выбранный" Click="DeleteVehicle_Click" Background="#B42318"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="VehiclesGrid" Grid.Row="1" ItemsSource="{Binding Vehicles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Владелец" Binding="{Binding OwnerName}" Width="2*"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                            <DataGridTextColumn Header="Госномер" Binding="{Binding RegistrationNumber}" Width="*"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="OrdersPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" CornerRadius="10" Padding="14">
                        <WrapPanel>
                            <ComboBox x:Name="OrderClientBox" Width="165" DisplayMemberPath="FullName" SelectedValuePath="Id" SelectionChanged="OrderClientBox_SelectionChanged" ToolTip="Клиент"/>
                            <ComboBox x:Name="OrderVehicleBox" Width="185" DisplayMemberPath="DisplayName" SelectedValuePath="Id" ToolTip="Автомобиль"/>
                            <TextBox x:Name="ProblemBox" Width="170" ToolTip="Неисправность"/>
                            <TextBox x:Name="WorkBox" Width="155" ToolTip="Работы"/>
                            <TextBox x:Name="CostBox" Width="90" ToolTip="Стоимость"/>
                            <Button Content="Создать заказ" Click="AddOrder_Click"/>
                            <Button Content="Удалить выбранный" Click="DeleteOrder_Click" Background="#B42318"/>
                            <Button Content="Завершить заказ" Click="CompleteOrder_Click" Background="#16804A"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="OrdersGrid" Grid.Row="1" ItemsSource="{Binding Orders}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtText}" Width="100"/>
                            <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Автомобиль" Binding="{Binding VehicleName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Неисправность" Binding="{Binding ProblemDescription}" Width="2*"/>
                            <DataGridTextColumn Header="Работы" Binding="{Binding WorkDescription}" Width="2*"/>
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding CostText}" Width="110"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="AboutPage" Visibility="Collapsed">
                    <Border Background="White" CornerRadius="10" Padding="24" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="AutoService Manager" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                            <TextBlock Text="Приложение для автоматизации базовых процессов автосервиса."
                                       Margin="0,12,0,0" Foreground="#6B7485" TextWrapping="Wrap"/>
                            <TextBlock Text="Технологии: C#, WPF, .NET 10, JSON." Margin="0,8,0,0"/>
                            <TextBlock Text="Команда: Рыбьянов Даниил и Шигаев Ильяс." Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
